# Postgres database (gratis via neon.tech)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Wachtwoord om in te loggen op je hub
ACCESS_PASSWORD="kies-een-wachtwoord"

# Geheime sleutel voor Health Auto Export (verzin een lange willekeurige string)
INGEST_SECRET="verzin-een-lange-geheime-string"

# Gemini API key (gratis via aistudio.google.com)
GEMINI_API_KEY="AIza..."

# Resend API key voor e-mail (resend.com, gratis)
RESEND_API_KEY="re_..."
EMAIL_TO="maxxherder@gmail.com"
EMAIL_FROM="Health Hub <onboarding@resend.dev>"

# Beveiliging van de wekelijkse cron (verzin een string; vul dezelfde in bij Vercel)
CRON_SECRET="verzin-nog-een-geheime-string"
